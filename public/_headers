# Cloudflare Edge Static Cache Headers
# Content-hashed Next.js static bundles - immutable forever
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Static media, icons, and fonts in public directory
/media/*
  Cache-Control: public, max-age=31536000, immutable

/favicon/*
  Cache-Control: public, max-age=31536000, immutable

/music/*
  Cache-Control: public, max-age=31536000, immutable

# Root SVG, ICO, and webmanifest assets
/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.avif
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable
